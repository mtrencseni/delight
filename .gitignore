# Dependencies and build output — regenerated by `pnpm install` / `pnpm tauri build`.
node_modules/
dist/
# The web UI's build (`pnpm build:web`), and the copy the server serves.
dist-web/

# Rust build artifacts. The workspace shares one target dir at the root now;
# src-tauri/target is left in case an old checkout still has one.
target/
src-tauri/target/
src-tauri/gen/

# Server: the shared secret, the served build, and the frontend's state blob.
server/.env
server/web/
server/state.json

# OS cruft (all platforms, so none has to see the others').
.DS_Store
Thumbs.db
desktop.ini
